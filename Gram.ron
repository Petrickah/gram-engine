BuildConfig(
    name: "gram-engine",
    version: "0.1.0",
    main: "GramRuntime",
    modules: [
        ModuleConfig(
            name: "gram",
            lang: "cargo",
            kind: "runtime",
            src: "gram/Cargo.toml",
            deps: [
                Registry(name: "clap"),
                Registry(name: "serde"),
                Registry(name: "ron"),
            ],
            targets: [
                "linux",
                "windows",
                "macos",
            ],
        ),
        ModuleConfig(
            name: "GramEngine",
            lang: "cmake",
            kind: "library",
            src: "GramEngine/CMakeLists.txt",
            deps: [
                Vcpkg(name: "vulkan"),
                Vcpkg(name: "glfw3"),
                Vcpkg(name: "glm"),
                Vcpkg(name: "imgui"),
                Git(
                    name: "spdlog",
                    url: "https://github.com/gabime/spdlog.git",
                    tag: "v1.17.0",
                ),
            ],
            targets: [
                "linux",
                "windows",
                "macos",
            ],
        ),
        ModuleConfig(
            name: "GramRuntime",
            lang: "cmake",
            kind: "runtime",
            src: "GramRuntime/CMakeLists.txt",
            deps: [
                Module(name: "GramEngine"),
            ],
            targets: [
                "windows",
                "linux",
                "macos",
            ],
        ),
    ],
)