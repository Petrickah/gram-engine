BuildConfig(
    name: "gram-engine",
    version: "0.1.0",
    main: "GramRuntime",
    modules: [
        ModuleConfig(
            name: "gram",
            lang: "gram",
            kind: "runtime",
            src: "gram/Gram.ron",
            deps: [],
            targets: [
                "linux",
                "windows",
                "macos",
            ],
        ),
        ModuleConfig(
            name: "GramEngine",
            lang: "cmake",
            kind: "library",
            src: "GramEngine/CMakeLists.txt",
            deps: [
                Vcpkg(
                    name: "vulkan",
                ),
                Vcpkg(
                    name: "glfw3",
                ),
                Vcpkg(
                    name: "glm",
                ),
                Vcpkg(
                    name: "imgui",
                ),
                Git(
                    name: "spdlog",
                    url: "https://github.com/gabime/spdlog.git",
                    tag: "v1.17.0",
                ),
            ],
            targets: [
                "linux",
                "windows",
                "macos",
            ],
        ),
        ModuleConfig(
            name: "Game",
            lang: "gram",
            kind: "runtime",
            src: "Game/Gram.ron",
            deps: [],
            targets: [
                "linux",
                "windows",
                "macos",
            ],
        ),
    ],
)