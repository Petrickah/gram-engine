BuildConfig(
    name: "gram-engine",
    version: "0.1.0",
    main: "GramRuntime",
    modules: [
        ModuleConfig(
            name: "gram",
            lang: "cargo",
            kind: "runtime",
            src: "gram/Cargo.toml",
            deps: [
                "clap",
                "serde",
                "ron",
            ],
            targets: [
                "linux",
                "windows",
                "macos",
            ],
        ),
        ModuleConfig(
            name: "GramEngine",
            lang: "cmake",
            kind: "library",
            src: "GramEngine/CMakeLists.txt",
            deps: [
                "vulkan",
                "glfw3",
                "glm",
                "imgui",
                "spdlog",
            ],
            targets: [
                "linux",
                "windows",
                "macos",
            ],
        ),
        ModuleConfig(
            name: "GramRuntime",
            lang: "cmake",
            kind: "runtime",
            src: "GramRuntime/CMakeLists.txt",
            deps: [
                "GramEngine",
            ],
            targets: [
                "windows",
                "linux",
                "macos",
            ],
        ),
    ],
)