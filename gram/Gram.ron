BuildConfig(
    name: "gram",
    version: "0.1.0",
    main: "gram-cli",
    modules: [
        ModuleConfig(
            name: "gram-common",
            lang: "cargo",
            kind: "library",
            src: "gram-common/Cargo.toml",
            deps: [],
            targets: [
                "linux",
                "windows",
                "macos",
            ],
        ),
        ModuleConfig(
            name: "gram-cli",
            lang: "cargo",
            kind: "runtime",
            src: "gram-cli/Cargo.toml",
            deps: [
                Module(
                    name: "gram-common",
                ),
            ],
            targets: [
                "linux",
                "windows",
                "macos",
            ],
        ),
        ModuleConfig(
            name: "gram-core",
            lang: "cargo",
            kind: "library",
            src: "gram-core/Cargo.toml",
            deps: [],
            targets: [
                "macos",
            ],
        ),
    ],
)